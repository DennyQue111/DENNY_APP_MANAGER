{
  "apps": [
    {
      "id": "ai_image_video_generator",
      "name": "AI 图片视频生成器",
      "description": "React 前端 + FastAPI 后端",
      "project": "ai_image_video_generator",
      "frontend_port": 5175,
      "backend_port": 8005,
      "frontend": {
        "cwd": "frontend",
        "command": ["npm", "run", "dev", "--", "--host", "127.0.0.1", "--port", "{port}", "--strictPort"],
        "backend_port": 8005
      },
      "backend": {
        "cwd": "backend",
        "command": ["{python}", "-m", "uvicorn", "main:app", "--host", "127.0.0.1", "--port", "{port}"]
      },
      "url": "http://127.0.0.1:{frontend_port}/"
    },
